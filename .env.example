# Copiar como .env (no se sube al repositorio). Lo usa docker-compose.yml.
POSTGRES_DB=norte
POSTGRES_USER=norte
POSTGRES_PASSWORD=cambiar_esta_clave

# Clave para firmar los tokens JWT del API cuando corre en Docker (mínimo 32 caracteres).
# El script scripts\configurar-entorno.cmd genera una al azar.
JWT_CLAVE=cambiar_por_una_clave_larga_de_al_menos_32_caracteres
